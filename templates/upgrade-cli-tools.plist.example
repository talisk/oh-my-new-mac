<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__CONFIRMED_LABEL__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__ABSOLUTE_SCRIPT_PATH__</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>53</integer></dict>
  <key>StandardOutPath</key><string>__ABSOLUTE_LAUNCHD_LOG_PATH__</string>
  <key>StandardErrorPath</key><string>__ABSOLUTE_LAUNCHD_LOG_PATH__</string>
</dict>
</plist>
